#!/usr/bin/env bash
# ─── Bonfyre Pages App Hook ──────────────────────────────────────────────────
set -euo pipefail

BONFYRE_BIN="${BONFYRE_BIN:-$HOME/.local/bin}"
export PATH="$BONFYRE_BIN:$PATH"

log() { printf "\033[0;33m[bonfyre]\033[0m %s\n" "$1"; }
err() { printf "\033[0;31m[bonfyre]\033[0m %s\n" "$1" >&2; }

require_bin() {
  for b in "$@"; do
    command -v "$b" >/dev/null 2>&1 || { err "Missing: $b (run 'make install' in bonfyre-oss)"; return 1; }
  done
}

BINS=(bonfyre-media-prep bonfyre-transcribe bonfyre-brief bonfyre-tag bonfyre-clips bonfyre-embed bonfyre-vec bonfyre-pack bonfyre-meter bonfyre-emit)
require_bin "${BINS[@]}" || exit 0

INTERVIEWS=$(git diff-tree --no-commit-id --name-only -r HEAD -- input/interviews/ 2>/dev/null || true)
REPORTS=$(git diff-tree --no-commit-id --name-only -r HEAD -- input/reports/ 2>/dev/null || true)

[ -z "$INTERVIEWS" ] && [ -z "$REPORTS" ] && exit 0

# Process stakeholder interviews
for f in $INTERVIEWS; do
  [ -f "$f" ] || continue
  base=$(basename "$f" | sed 's/\.[^.]*$//')
  ext="${f##*.}"

  case "$ext" in
    wav|mp3|m4a|ogg|flac|webm)
      log "[$base] interview → transcribe → brief → clips → tag → embed"
      bonfyre-media-prep "$f" --out "artifacts/${base}.prep.json"
      bonfyre-transcribe "artifacts/${base}.prep.json" --out "artifacts/${base}.transcript.json"
      bonfyre-brief "artifacts/${base}.transcript.json" --out "artifacts/${base}.brief.json"
      bonfyre-clips "artifacts/${base}.transcript.json" --out "artifacts/${base}.clips.json"
      bonfyre-tag "artifacts/${base}.brief.json" --out "artifacts/${base}.tags.json"
      bonfyre-embed "artifacts/${base}.tags.json" --out "artifacts/${base}.embed.json"
      bonfyre-vec "artifacts/${base}.embed.json" --insert-db "artifacts/evidence.db"
      bonfyre-meter "artifacts/${base}.brief.json" --op impact-story
      ;;
    *) log "[$base] skipping: $ext" ;;
  esac
done

# Process written reports / program data
for f in $REPORTS; do
  [ -f "$f" ] || continue
  base=$(basename "$f" | sed 's/\.[^.]*$//')
  log "[$base] report → brief → tag → embed"
  bonfyre-brief "$f" --out "artifacts/${base}.brief.json"
  bonfyre-tag "artifacts/${base}.brief.json" --out "artifacts/${base}.tags.json"
  bonfyre-embed "artifacts/${base}.tags.json" --out "artifacts/${base}.embed.json"
  bonfyre-vec "artifacts/${base}.embed.json" --insert-db "artifacts/evidence.db"
done

log "Building evidence site…"
bonfyre-emit artifacts/ --out site/ --format html
bonfyre-pack artifacts/ --out "artifacts/evidence-bundle.zip"
log "Evidence base updated. $(find artifacts/ -name '*.clips.json' | wc -l | tr -d ' ') stakeholder stories."
